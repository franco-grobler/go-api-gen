{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(devbox run:*)",
      "Bash(devbox install:*)",
      "Bash(just:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go run ./cmd/go-api-gen:*)",
      "Bash(git cliff:*)",
      "Bash(committed:*)",
      "Bash(mdbook build:*)"
    ]
  }
}
